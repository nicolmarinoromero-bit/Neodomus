{
  "expo": {
    "name": "NeoDomus",
    "slug": "neodomus",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/Logo.jpg",

    "scheme": "neodomus",

    "userInterfaceStyle": "automatic",

    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}